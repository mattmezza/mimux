/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  # The only external origin permitted is the self-hosted Umami instance —
  # the privacy claim in the footer depends on this staying exact.
  # form-action names the two hosts a buy button touches and nothing else: the
  # /pricing/ forms POST to account.mimux.dev/checkout, which 303s to Stripe's
  # hosted card form. form-action is enforced on the redirect target too, so
  # checkout.stripe.com has to be listed or the browser blocks the submission
  # outright — and it reports the original action URL, which makes it look like
  # account.mimux.dev is the one being refused. Anywhere wider would let
  # injected markup post a visitor's input off-site.
  Content-Security-Policy: default-src 'self'; script-src 'self' https://analytics.casa.merola.co; connect-src 'self' https://analytics.casa.merola.co; img-src 'self'; style-src 'self' 'sha256-rjTmV83lO33lADNfpwEQAmHoUNbDj1hVXFHO5UQkBt4='; font-src 'self'; object-src 'none'; base-uri 'none'; form-action https://account.mimux.dev https://checkout.stripe.com; frame-ancestors 'none'

/img/*.webp
  Cache-Control: public, max-age=31536000, immutable

/img/*.png
  Cache-Control: public, max-age=31536000, immutable

/img/*.jpg
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/css/*
  Cache-Control: public, max-age=3600

# Filenames are content-hashed at build time (site.<hash>.js), so a new build
# is a new URL and this can never serve stale code.
/js/*
  Cache-Control: public, max-age=31536000, immutable
