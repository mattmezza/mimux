/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  # The only external origin permitted is the self-hosted Umami instance —
  # the privacy claim in the footer depends on this staying exact.
  # form-action names account.mimux.dev and nothing else: the buy buttons on
  # /pricing/ are forms that POST to its /checkout, which redirects to Stripe,
  # so one click gets to the card form. 'none' blocked that outright. Anywhere
  # wider would let injected markup post a visitor's input off-site.
  Content-Security-Policy: default-src 'self'; script-src 'self' https://analytics.casa.merola.co; connect-src 'self' https://analytics.casa.merola.co; img-src 'self'; style-src 'self'; font-src 'self'; object-src 'none'; base-uri 'none'; form-action https://account.mimux.dev; frame-ancestors 'none'

/img/*.webp
  Cache-Control: public, max-age=31536000, immutable

/img/*.png
  Cache-Control: public, max-age=31536000, immutable

/img/*.jpg
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/css/*
  Cache-Control: public, max-age=3600

# Filenames are content-hashed at build time (site.<hash>.js), so a new build
# is a new URL and this can never serve stale code.
/js/*
  Cache-Control: public, max-age=31536000, immutable
