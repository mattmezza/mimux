/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  # The only external origin permitted is the self-hosted Umami instance —
  # the privacy claim in the footer depends on this staying exact.
  # form-action names the two hosts a buy button touches and nothing else: the
  # /pricing/ forms POST to account.mimux.dev/checkout, which 303s to Stripe's
  # hosted card form. form-action is enforced on the redirect target too, so
  # checkout.stripe.com has to be listed or the browser blocks the submission
  # outright — and it reports the original action URL, which makes it look like
  # account.mimux.dev is the one being refused. Anywhere wider would let
  # injected markup post a visitor's input off-site.
  Content-Security-Policy: default-src 'self'; script-src 'self' https://analytics.casa.merola.co; connect-src 'self' https://analytics.casa.merola.co; img-src 'self'; style-src 'self'; font-src 'self'; object-src 'none'; base-uri 'none'; form-action https://account.mimux.dev https://checkout.stripe.com; frame-ancestors 'none'

/img/*.webp
  Cache-Control: public, max-age=31536000, immutable

/img/*.png
  Cache-Control: public, max-age=31536000, immutable

/img/*.jpg
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/css/*
  Cache-Control: public, max-age=3600

# The installer. text/plain so a browser shows it instead of offering a
# download — anyone about to pipe a script into bash should be one click from
# reading it. Barely cached, because it names release URLs and has to be able
# to change with a release rather than a day later.
/install.sh
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=300

# Filenames are content-hashed at build time (site.<hash>.js), so a new build
# is a new URL and this can never serve stale code. build.sh keeps the previous
# build's bundle on disk for a month so the HTML below, which may be a few
# minutes stale, never asks for a file that is no longer there.
# Deliberately not /js/* : the unhashed /js/site.js is still emitted as a
# fallback and its contents change from build to build, so a year of immutable
# on that one URL is the exact stale-code trap the hashing exists to close.
/js/site.*.js
  Cache-Control: public, max-age=31536000, immutable

# HTML is the one thing that must not be cached hard: it carries the pinned
# /js/<hash>.js filename and the inlined stylesheet, so a stale copy is a page
# driven by last month's build. must-revalidate rather than no-store — the
# conditional request still ends in a 304 the overwhelming majority of the time.
#
# Spelled out per shape instead of on /* above, because Cloudflare Pages joins
# duplicate headers with a comma rather than letting the more specific rule win:
# a Cache-Control here plus the immutable ones above would arrive at the browser
# as one nonsense value and take the year-long asset caching down with it.
# Pages are directory-index style, so the request path is / or /pricing/ and
# never ends in .html — except 404.html, which Cloudflare serves by name.
/
  Cache-Control: public, max-age=0, must-revalidate

/:page/
  Cache-Control: public, max-age=0, must-revalidate

/*.html
  Cache-Control: public, max-age=0, must-revalidate
