# Copy to account.env on the VPS, fill in, chmod 600. Never commit the filled-in
# version — account.env is gitignored for that reason. Every value below is a
# placeholder.

STRIPE_SECRET_KEY=sk_live_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
STRIPE_PRICE_ANNUAL=price_REPLACE_ME_ANNUAL
STRIPE_PRICE_PERPETUAL=price_REPLACE_ME_PERPETUAL

# Output of `go run . -genkey`. Private half. Backups off this machine.
LICENCE_SIGNING_KEY_B64=REPLACE_ME_BASE64_ED25519_PRIVATE_KEY

BASE_URL=https://account.mimux.dev
# Bump on every mimux release: this is the perpetual licence watermark.
CURRENT_VERSION=v0.19

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=REPLACE_ME
SMTP_PASS=REPLACE_ME
SMTP_FROM=licences@mimux.dev
